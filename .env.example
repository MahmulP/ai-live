# Salin file ini menjadi .env lalu isi nilainya.

# --- Claude (wajib) ---
# Ambil di https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# (Sengaja AI_*, bukan CLAUDE_*: Claude Code mengekspor CLAUDE_EFFORT dan nilai itu akan menimpa .env.)
# AI hanya dipakai untuk membalas chat; gift, follow, sapaan, dan basa-basi memakai template gratis.
# Biaya per balasan chat kira-kira (effort low): haiku-5-5 + thinking off $0.0002, sonnet-5-5 $0.0022, opus-5-5 $0.0045
AI_MODEL=claude-haiku-5-5
# low = paling cepat dan murah untuk live. Pilihan: low, medium, high, xhigh, max
AI_EFFORT=low
# off = matikan proses "berpikir" Claude: lebih cepat dan murah. Hanya untuk claude-sonnet-5-5 dan
# claude-haiku-5-5 (Opus 5.5 selalu berpikir), dan hanya dengan AI_EFFORT low, medium, atau high.
AI_THINKING=off
# Batas biaya Claude per hari kalender, dalam dolar. Kalau tercapai, chat tidak dibalas sampai besok
# (gift, sapaan, dan basa-basi tetap jalan). 0 = tanpa batas. Total hari ini tersimpan di logs/spend.json.
MAX_DAILY_USD=10
# Isi "demo" untuk tes avatar, suara, dan OBS tanpa memanggil Claude (jawaban contoh).
AI_MODE=

# --- Identitas AI ---
AI_NAME=Ucok
PERSONA_FILE=persona.md

# --- TikTok LIVE ---
# Username akun yang sedang live (tanpa @). Kosongkan untuk tes pakai panel ?debug saja.
TIKTOK_USERNAME=
# Opsional: API key Euler Stream untuk menaikkan batas koneksi pembaca chat.
TIKTOK_SIGN_API_KEY=

# --- Suara (TTS) ---
# Claude/Anthropic tidak punya text-to-speech, jadi suaranya dari layanan lain:
# edge       = suara neural Microsoft Edge, natural, GRATIS tanpa API key (tidak resmi, bisa berhenti kapan saja)
# elevenlabs = ElevenLabs, paling natural, bisa pilih/desain/kloning suara, berbayar
# azure      = Azure AI Speech (suara sama dengan edge, versi resmi), ada free tier
# browser    = suara bawaan browser/OS, kaku dan hanya untuk tes (tidak terdengar di OBS)
# Tes suaranya dulu tanpa live: npm run tts -- "Horas kawan, apa kabar kau?"
TTS_PROVIDER=edge

# id-ID-ArdiNeural (pria) atau id-ID-GadisNeural (wanita)
EDGE_VOICE=id-ID-ArdiNeural
# Kecepatan dan nada, format SSML: misalnya +5%, -10%, +2Hz, +1st
EDGE_RATE=+5%
EDGE_PITCH=+0Hz

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# id-ID-ArdiNeural (pria) atau id-ID-GadisNeural (wanita)
AZURE_VOICE=id-ID-ArdiNeural

ELEVENLABS_API_KEY=
# Voice ID dari elevenlabs.io → Voices → pilih suara → "Copy voice ID"
ELEVENLABS_VOICE_ID=
# eleven_v4_turbo   = natural dan cepat (~100ms), cocok untuk live (default)
# eleven_v4         = paling natural dan ekspresif, lebih lambat
# eleven_flash_v2_5 = paling cepat (~75ms) dan paling murah, sedikit kurang natural
ELEVENLABS_MODEL=eleven_v4_turbo
# 0–1. Lebih rendah = lebih ekspresif/naik-turun, lebih tinggi = lebih datar dan stabil.
ELEVENLABS_STABILITY=0.45
# 0–1. Seberapa mirip dengan suara aslinya.
ELEVENLABS_SIMILARITY=0.75
# 0–1. Melebih-lebihkan gaya bicara pembicara asli; di atas 0 menambah latensi.
ELEVENLABS_STYLE=0
# 1 = kecepatan normal.
ELEVENLABS_SPEED=1

# --- Ritme & filter ---
# Jeda setelah AI selesai bicara sebelum menjawab komentar berikutnya
REPLY_GAP_SECONDS=3
# Kalau chat sepi selama ini, AI membuka obrolan sendiri (basa-basi), hanya saat live dan ada yang nonton. 0 = matikan.
IDLE_TALK_SECONDS=60
# Menyapa penonton yang baru masuk, paling sering sekali per sekian detik (beberapa nama digabung). 0 = matikan.
GREET_JOINS_SECONDS=60
# Satu penonton hanya bisa masuk antrian sekali dalam periode ini
USER_COOLDOWN_SECONDS=15
# Tambahan kata terlarang, dipisah koma
EXTRA_BANNED_WORDS=

# --- Siaran dari server Linux (docker compose) ---
# Dari livecenter.tiktok.com/producer setelah klik "Save & Go LIVE". Bisa berganti tiap sesi live:
# update dengan ./scripts/set-stream-key.sh "<Server URL>" "<Stream Key>"
STREAM_URL=
STREAM_KEY=
# 720x1280 30 fps cukup ringan untuk VPS tanpa GPU. Naikkan kalau CPU-nya kuat.
STREAM_WIDTH=720
STREAM_HEIGHT=1280
STREAM_FPS=30
# Avatar 3D dirender CPU; 15 fps hemat (sekitar 2 core). Naikkan ke 24 atau 30 kalau CPU-nya kuat.
STREAM_RENDER_FPS=15
STREAM_VIDEO_KBPS=2500
# superfast hemat CPU; veryfast sedikit lebih tajam tapi lebih berat.
STREAM_PRESET=superfast

# Port backend (WebSocket + halaman hasil build)
SERVER_PORT=8787
