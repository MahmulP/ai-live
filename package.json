{
  "name": "tiktok-ai-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI host untuk TikTok LIVE: baca chat, jawab pakai Claude, bicara lewat TTS, avatar 3D di browser.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "demo": "AI_MODE=demo npm run dev",
    "tts": "tsx src/server/tts-test.ts",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@fontsource/nunito": "^5.3.0",
    "msedge-tts": "^2.1.0",
    "three": "^0.186.1",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
